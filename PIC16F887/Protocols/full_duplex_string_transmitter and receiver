#include <xc.h>
char str[]="Tahareem";
char data1;

void delay(unsigned int t)
{
    while(t--);
}

void enable()
{
    RE1=1;
    delay(1000);
    RE1=0;
    delay(1000);
}

void lcd(char cmd,char data)
{
    RE0=cmd;
    PORTD=data;
    enable();
}

void transmit(char data)
{
    while(!TXIF);      
    TXREG=data;
}

void receiver()
{
    while(!RCIF);      
    data1=RCREG;
}

void uart_string(char *ptr)
{
    while(*ptr!='\0')
    {
        transmit(*ptr);    

        receiver();         

        lcd(1,data1);       

        ptr++;
    }
}

void main()
{
