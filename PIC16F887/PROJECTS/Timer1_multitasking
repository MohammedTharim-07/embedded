// PIC16F887 Configuration Bit Settings

// CONFIG1
#pragma config FOSC = INTRC_NOCLKOUT
#pragma config WDTE = OFF
#pragma config PWRTE = ON
#pragma config MCLRE = ON
#pragma config CP = OFF
#pragma config CPD = OFF
#pragma config BOREN = OFF
#pragma config IESO = ON
#pragma config FCMEN = ON
#pragma config LVP = OFF

// CONFIG2
#pragma config BOR4V = BOR40V
#pragma config WRT = OFF

#include <xc.h>

void led_1200ms();
void led_2100ms();
void button_1();
void button_2();
void button_3();
 void delay();
 unsigned char last_value = 0;
 unsigned char btn3_active = 0;
unsigned int count,refresh;
int i;
 unsigned char arr[10]={0x3f,0x06,0x5b,0x4f,0x66,0x6d,0x7d,0x07,0x7f,0x6f};
 

 void delay(unsigned int ms)
{
    unsigned int i;

    for(i = 0; i < ms; i++)
    {
        TMR1H = 0xFF;
        TMR1L = 0x06;      // 250 counts

        PIR1bits.TMR1IF = 0;
        T1CONbits.TMR1ON = 1;
        while(!PIR1bits.TMR1IF);
        T1CONbits.TMR1ON = 0;  
    }
}

void led_1200ms()
{
    delay(1200);
       
               RA3=1;
}

void led_2100ms()
{
     delay(2100);
     RA4=1;
}

void button_1()
{
    if(RA0)
    {
for(i=0;i<=99;i++)
{
    last_value = i;
    if(RA0==0)
    {
        while(RA0==0)
        {
             if(RA1 == 1)
             return;
             if(RA2==1)
                 return;
            // freeze current number
             
            PORTE=0X0F;
            PORTC=arr[i%10];
            PORTE=0X01;
            delay(2);

            PORTE=0X0F;
            PORTC=arr[i/10];
            PORTE=0X02;
            delay(2);
        }
    }

    for(refresh=0; refresh<250; refresh++)
    {
        PORTE=0X0F;
        PORTC=arr[i%10];
        PORTE=0X01;
        delay(2);

        PORTE=0X0F;
        PORTC=arr[i/10];
        PORTE=0X02;
        delay(2);
       /*if(i==99)
            i=0;*/
    }
}
}
}
void button_2()
{
    if(RA1==1)
    {
        for(i=last_value;i>=0;i--)
        {
            
            
            if(RA1==0)
            {
                last_value=i;
                while(RA1==0)
                {
                    if(RA0==1)
                        return;
                    if(RA2==1)
                        return;
                    PORTE=0X0F;
                    PORTC=arr[i%10];
                    PORTE=0X01;
                    delay(2);

                    PORTE=0X0F;
                    PORTC=arr[i/10];
                    PORTE=0X02;
                    delay(2);
                }
            }

            for(refresh=0; refresh<250; refresh++)
            {
                PORTE=0X0F;
                PORTC=arr[i%10];
                PORTE=0X01;
                delay(2);

                PORTE=0X0F;
                PORTC=arr[i/10];
                PORTE=0X02;
                delay(2);
            }
        }
    }
}

void button_3()
{
    unsigned int sec;

    if(RA2 == 1 && btn3_active == 0)   
    {
        btn3_active = 1;   

        RD0 =  1;
        RD1 = 1;
        RD2 = 0;

        for(sec = last_value; sec > 0; sec--)
        {
            for(refresh = 0; refresh < 250; refresh++)
            {
                PORTE = 0X0F;
                PORTC = arr[sec % 10];
                PORTE = 0X01;
                delay(2);
                PORTE = 0X0F;
                PORTC = arr[sec / 10];
                PORTE = 0X02;
                delay(2);
            }
        }

        PORTE = 0X0F;
        PORTC = arr[0];
        PORTE = 0X01;
        delay(2);
        PORTE = 0X0F;
        PORTC = arr[0];
        PORTE = 0X02;
        delay(2);

        RD0 = 0;
        RD1 = 0;
        RD2 = 1;
    }

    if(RA2 == 0)
    {
        btn3_active = 0;   
    }
}
void main(void)
{
    PORTA=PORTC=PORTE=PORTD=0X00;
    TRISA=0X07;
    TRISD=0X00;
   
    TRISC=TRISE=0X00;
    ANSEL=ANSELH=0X00;
    T1CON=0X21;
    
   led_1200ms();
    led_2100ms();
    // TMR1= 40535;
    while(1)
    {
     button_1();
     button_2();
     button_1(); 
     button_3();
    }
      

}
