void disp_call(unsigned char *ptr,int c)
{
    while(c--)   // delay(1000)
    {
     PORTD=0X0f;
         PORTC=*ptr;
        PORTD=0X0E;
        __delay_ms(10);
        
         PORTD=0X0f;
         PORTC=*(ptr+1);
         PORTD=0X0d;
        __delay_ms(10);
        
         PORTD=0X0f;
         PORTC=*(ptr+4);
         PORTD=0X0b;
        __delay_ms(10);
        
        PORTD=0X0f;
         PORTC=*(ptr+4);
        PORTD=0X07;
        __delay_ms(10);
}
    PORTC=0x00;
}


