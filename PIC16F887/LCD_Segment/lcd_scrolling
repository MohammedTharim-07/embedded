

// PIC16F887 Configuration Bit Settings

// CONFIG1
#pragma config FOSC = INTRC_NOCLKOUT
#pragma config WDTE = OFF
#pragma config PWRTE = ON
#pragma config MCLRE = ON
#pragma config CP = OFF
#pragma config CPD = OFF
#pragma config BOREN = OFF
#pragma config IESO = ON
#pragma config FCMEN = ON
#pragma config LVP = OFF

// CONFIG2
#pragma config BOR4V = BOR40V
#pragma config WRT = OFF

#include <xc.h>

void delay(unsigned int t);
void enable(void);
void lcd(char cmd, char data);
void lcd_string(char *str);

char str[] = "WHERE ARE GOING";

void delay(unsigned int t)
{
    while(t--);
}

void enable(void)
{
    RE1 = 1;
    delay(1000);

    RE1 = 0;
    delay(1000);
}

void lcd(char cmd, char data)
{
    RE0 = cmd;
    PORTD = data;
    enable();
}

void lcd_string(char *str)
{
    while(*str != '\0')
    {
        lcd(1, *str);
        str++;
    }
}

void main(void)
{
    int i;

    PORTD = 0x00;
    PORTE = 0x00;

    ANSEL = 0x00;
    ANSELH = 0x00;

    TRISD = 0x00;
    TRISE = 0x00;

 
    lcd(0, 0x38);   
    lcd(0, 0x0E);   
    lcd(0, 0x01);   
    lcd(0, 0x06);  

    while(1)
    {
        // Move text from right to left
        for(i = 0; i <= 15; i++)
        {
            lcd(0, 0x01);              

            lcd(0, 0x80 + (15 - i));     

            lcd_string(str);             

            delay(2000);
        }
        
        
         for(i = 15; i >=0; i--)
        {
            lcd(0, 0x01);               

            lcd(0, 0x80 + (15 - i));    

            lcd_string(str);        

            delay(2000);
        }
        
    }
}
